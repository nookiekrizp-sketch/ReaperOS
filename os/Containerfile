# ReaperOS: a Bazzite-based operating system that boots straight into ReaperOS.
# Built with GitHub Actions and published to ghcr.io; install it by switching a
# Bazzite PC to this image (see README "ReaperOS OS").

ARG BASE_IMAGE=ghcr.io/ublue-os/bazzite:stable

# Build scripts and files, kept out of the final image
FROM scratch AS ctx
COPY build.sh /build.sh
COPY system_files /system_files

FROM ${BASE_IMAGE}

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh

RUN bootc container lint
